{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "Taskflow task-tracking API (Node.js 20 / Express / PostgreSQL) - case study for Jenkins CI/CD lab manual",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint src",
    "lint:security": "eslint --plugin security src",
    "test": "jest",
    "test:ci": "jest --coverage --reporters=default --reporters=jest-junit",
    "test:e2e": "playwright test"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "cobertura",
      "lcov"
    ],
    "coverageDirectory": "coverage"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  }
}
